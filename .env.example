# Commerce kill switch (default off). Never commit real secrets.
# Site static build — shows buy UI only when true; still needs the checkout API.
# NEXT_PUBLIC_COMMERCE_ENABLED=false

# Cloudflare Pages Function runtime (see functions/api/checkout/session.ts)
# COMMERCE_ENABLED=false          # must stay false until launch; Function returns 503 when off
# STRIPE_SECRET_KEY=sk_live_...   # set in Cloudflare dashboard only — never commit

# Portal URLs (Stripe Dashboard bpc_… config — see lib/commerce-checkout.ts PORTAL_URLS):
#   privacy → https://shitechworks.com/privacy
#   terms   → https://shitechworks.com/terms
#   return  → https://shitechworks.com/store/account/
